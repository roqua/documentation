---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<img class="inline-icon" src={`/icons/${name}.png`} alt={name} />

<style>
  .inline-icon {
    vertical-align: middle;
    margin: 0;
    max-height: 21px; /* Keep in sync with line-height */
    display: inline;
  }
</style>
